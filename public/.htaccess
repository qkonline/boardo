# Boardo (kaiserkhan.com/boardo/): a static app, no server code.

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddType image/svg+xml .svg
</IfModule>

# The WordPress root turns on mod_expires with a one-week default. Switch it off here and set
# caching explicitly.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  # Default: revalidate every time (the page, sw.js, the manifest).
  Header set Cache-Control "no-cache"
  # Icons with fixed names may change between releases: a day.
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Fingerprinted build files never change: cache them for a year. (Last, so it wins.)
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
